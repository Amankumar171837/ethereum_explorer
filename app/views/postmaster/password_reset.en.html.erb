<!-- Background wrapper with gradient -->
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%"
       style="background-color: #010101; width:600px; margin:0 auto;" class="dark-mode-bg">
  <tr>
    <td align="center" style="padding: 0;">
      <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%"
             style="background: radial-gradient(ellipse at 100% 100%, rgba(253, 253, 31, 0.15) 0%, rgba(253, 253, 31, 0.08) 25%, rgba(253, 253, 31, 0.02) 50%, #010101 70%); background-color: #010101;">
        <tr>
          <td align="center" style="padding: 40px 20px;">

            <table role="presentation" cellpadding="0" cellspacing="0" border="0" class="container"
                   style="max-width: 600px; width: 100%;">

              <tr>
                <td align="center" style="padding-bottom: 30px;">
                  <img
                    src="https://prod-blockmaze-bucket.s3.ap-southeast-1.amazonaws.com/logo.png"
                    alt="Blockmaze"
                    width="180"
                    style="display:block;width:180px;max-width:100%;height:auto;"
                  >
                </td>
              </tr>

              <tr>
                <td align="center" style="padding-bottom: 25px;">
                  <img
                    src="https://prod-blockmaze-bucket.s3.ap-southeast-1.amazonaws.com/PinCode.png"
                    alt="Password Reset"
                    width="120"
                    style="display:block;width:120px;max-width:100%;height:auto;"
                  >
                </td>
              </tr>

              <tr>
                <td align="center" style="padding-bottom: 30px;">
                  <h1 style="margin: 0; font-family: 'Inter', sans-serif; font-size: 18px; font-weight: 500; color: #ffffff;"
                      class="dark-mode-text">
                    Reset Your Password
                  </h1>
                </td>
              </tr>

              <tr>
                <td align="center">
                  <table role="presentation" cellpadding="0" cellspacing="0" border="0"
                         width="100%" class="card"
                         style="background-color: #3B3B3B33; border-radius: 20px;">
                    <tr>
                      <td style="padding: 20px 25px;">

                        <table role="presentation" cellpadding="0" cellspacing="0"
                               border="0" width="100%">
                          <tr>
                            <td align="center" style="padding-bottom: 20px;">
                              <p style="margin: 0; font-family: 'Inter', sans-serif; font-size: 16px; font-weight: 500; color: #ffffff;"
                                 class="dark-mode-text">
                                Hi <%= @record&.user&.name %>,
                              </p>
                            </td>
                          </tr>
                          <tr>
                            <td align="center" style="padding-bottom: 30px;">
                              <p
                                style="margin: 0; font-family: 'Inter', sans-serif; font-size: 16px; font-weight: 500; line-height: 22px; color: #fff;">
                                We received a request to reset your BlockMaze ID
                                password. Click the button below to create a new
                                password.
                              </p>
                            </td>
                          </tr>
                        </table>

                        <table role="presentation" cellpadding="0" cellspacing="0"
                               border="0" width="100%">
                          <tr>
                            <td align="center" style="padding-bottom: 30px;">
                              <table role="presentation" cellpadding="0"
                                     cellspacing="0" border="0">
                                <tr>
                                  <td align="center"
                                      style="background-color: #FDFD1F; border-radius: 10px;">
                                    <a href="<%= @record.domain %>/reset-password/<%= @record.token %>" target="_blank"
                                       style="display: inline-block; padding: 14px 45px; font-family: 'Inter', sans-serif; font-size: 15px; font-weight: 600; color: #010101; text-decoration: none;">
                                      Reset Password
                                    </a>
                                  </td>
                                </tr>
                              </table>
                            </td>
                          </tr>
                        </table>

                        <table role="presentation" cellpadding="0" cellspacing="0"
                               border="0" width="100%">
                          <tr>
                            <td align="center" style="padding-bottom: 15px;">
                              <p
                                style="margin: 0; font-family: 'Inter', sans-serif; font-size: 14px; color: #ffffff; font-weight: 300;">
                                Or copy and paste this link into your browser:
                              </p>
                            </td>
                          </tr>
                        </table>

                        <table role="presentation" cellpadding="0" cellspacing="0"
                               border="0" width="100%" class="url-box"
                               style="background-color: #2B2B2B; border-radius: 10px;">
                          <tr>
                            <td style="padding: 15px 20px;">
                              <table role="presentation" cellpadding="0"
                                     cellspacing="0" border="0" width="100%">
                                <tr>
                                  <td style="font-family: 'Inter', sans-serif;
                                      font-size: 14px;
                                      color: #ffffff;
                                      font-weight: 500;
                                      word-break: break-all;"
                                      class="url-text">
                                    <%= @record.domain %>/reset-password/<%= @record.token %>
                                  </td>
                                  <td align="right" style="padding-left: 15px; white-space: nowrap;">
                                    <a href="<%= @record.domain %>/reset-password/<%= @record.token %>"
                                       style="font-family: 'Inter', sans-serif;
                                           font-size: 16px;
                                           font-weight: 500;
                                           color: #6D8AFA;
                                           text-decoration: none;">
                                      Copy
                                    </a>
                                  </td>

                                </tr>
                              </table>
                            </td>
                          </tr>
                        </table>

                      </td>
                    </tr>
                  </table>
                </td>
              </tr>

              <tr>
                <td align="center" style="padding: 30px 20px;">
                  <p
                    style="margin: 0; font-family: 'Inter', sans-serif; font-size: 14px; line-height: 20px; color: #ffffff; font-weight: 300;">
                    This link expires in <span style="color: #FDFD1F; font-weight: 600;"
                                               class="dark-mode-yellow">60 minutes.</span> If you didn't request a
                    password reset,<br>
                    please ignore this email or contact support if you're concerned.
                  </p>
                </td>
              </tr>

              <tr>
                <td align="center" style="padding: 0 60px;">
                  <table role="presentation" cellpadding="0" cellspacing="0" border="0"
                         width="100%">
                    <tr>
                      <td
                        style="border-top: 1px solid #333333; height: 1px; font-size: 0; line-height: 0;">
                        &nbsp;</td>
                    </tr>
                  </table>
                </td>
              </tr>

              <tr>
                <td align="center" style="padding: 30px 20px 40px;">
                  <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                    <tr>
                      <td align="center" style="padding-bottom: 10px;">
                        <p style="margin: 0; font-family: 'Inter', sans-serif; font-size: 16px; font-weight: 600; color: #ffffff;"
                           class="dark-mode-text">
                          Thank you for choosing Blockmaze!
                        </p>
                      </td>
                    </tr>
                    <tr>
                      <td align="center">
                        <p
                          style="margin: 0; font-family: 'Inter', sans-serif; font-size: 14px; line-height: 20px; color: #ffffff; font-weight: 300;">
                          Best regards,<br>
                          Blockmaze Team
                        </p>
                      </td>
                    </tr>
                  </table>
                </td>
              </tr>
            </table>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
