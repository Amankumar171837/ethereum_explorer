<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%"
       style="background-color: #010101; width:600px; margin:0 auto;" class="dark-mode-bg">
  <tr>
    <td align="center" style="padding: 0;">
      <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%"
             style="background: radial-gradient(ellipse at 100% 100%, rgba(253, 253, 31, 0.15) 0%, rgba(253, 253, 31, 0.08) 25%, rgba(253, 253, 31, 0.02) 50%, #010101 70%); background-color: #010101;">
        <tr>
          <td align="center" style="padding: 40px 20px;">

            <table role="presentation" cellpadding="0" cellspacing="0" border="0" class="container"
                   style="max-width: 600px; width: 100%;">

              <tr>
                <td align="center" style="padding-bottom: 30px;">
                  <img
                    src="https://prod-blockmaze-bucket.s3.ap-southeast-1.amazonaws.com/logo.png"
                    alt="Blockmaze"
                    width="180"
                    style="display:block;margin-bottom:30px;max-width:100%;height:auto;"
                  >
                </td>
              </tr>

              <tr>
                <td align="center" style="padding-bottom: 25px;">
                  <img
                    src="https://prod-blockmaze-bucket.s3.ap-southeast-1.amazonaws.com/Smart_ID_card.png"
                    alt="OTP"
                    width="120"
                    style="display:block;margin-bottom:25px;max-width:100%;height:auto;"
                  >
                </td>
              </tr>

              <tr>
                <td align="center" style="padding-bottom: 20px;">
                  <h1 style="margin: 0; font-family: 'Inter', sans-serif; font-size: 18px; font-weight: 500; color: #ffffff;"
                      class="dark-mode-text">
                    Hi <%= @record&.user&.name %>
                  </h1>
                </td>
              </tr>

              <tr>
                <td align="center">
                  <table role="presentation" cellpadding="0" cellspacing="0" border="0"
                         width="100%" class="card"
                         style="background-color: #3B3B3B33; border-radius: 20px;">
                    <tr>
                      <td style="padding: 20px 25px;">

                        <table role="presentation" cellpadding="0" cellspacing="0"
                               border="0" width="100%">
                          <tr>
                            <td align="center" style="padding-bottom: 30px;">
                              <p
                                style="margin: 0; font-family: 'Inter', sans-serif; font-size: 16px; font-weight: 500; line-height: 22px; color: #fff;">
                                Here's you're verification code before you can
                                access the platform
                              </p>
                            </td>
                          </tr>
                        </table>

                        <table role="presentation" cellpadding="0" cellspacing="0"
                               border="0" width="100%">
                          <tr>
                            <td align="center" style="padding-bottom: 15px;">
                              <p
                                style="margin: 0; font-family: 'Inter', sans-serif; font-size: 14px; color: #ffffff; font-weight: 300;">
                                Enter the code below into your app
                              </p>
                            </td>
                          </tr>
                        </table>

                        <table role="presentation" cellpadding="0" cellspacing="0"
                               border="0" align="center"
                               style="background-color: #2B2B2B; border-radius: 10px;">
                          <tr>
                            <td align="center" style="padding: 15px 30px;">
                                                                <span
                                                                  style="font-family: 'Inter', sans-serif; font-size: 28px; color: #ffffff; font-weight: 500; letter-spacing: 0.5em;">
                                                                  <%= @record.otp.gsub(%r{\s*}, " ").strip %>
                                                                </span>
                            </td>
                          </tr>
                        </table>

                      </td>
                    </tr>
                  </table>
                </td>
              </tr>

              <tr>
                <td align="center" style="padding: 30px 20px;">
                  <p
                    style="margin: 0; font-family: 'Inter', sans-serif; font-size: 14px; line-height: 20px; color: #ffffff; font-weight: 300;">
                    If you need any assistance, our support team is here to help. Just reply to
                    this email or contact us at <span style="color: #FDFD1F; font-weight: 600;"
                                                      class="dark-mode-yellow">hello@blockmaze.com</span>
                  </p>
                </td>
              </tr>

              <tr>
                <td align="center" style="padding: 0 60px;">
                  <table role="presentation" cellpadding="0" cellspacing="0" border="0"
                         width="100%">
                    <tr>
                      <td
                        style="border-top: 1px solid #333333; height: 1px; font-size: 0; line-height: 0;">
                        &nbsp;</td>
                    </tr>
                  </table>
                </td>
              </tr>

              <tr>
                <td align="center" style="padding: 30px 20px 40px;">
                  <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                    <tr>
                      <td align="center" style="padding-bottom: 10px;">
                        <p style="margin: 0; font-family: 'Inter', sans-serif; font-size: 16px; font-weight: 600; color: #ffffff;"
                           class="dark-mode-text">
                          Thank you for choosing Blockmaze!
                        </p>
                      </td>
                    </tr>
                    <tr>
                      <td align="center">
                        <p
                          style="margin: 0; font-family: 'Inter', sans-serif; font-size: 14px; line-height: 20px; color: #ffffff; font-weight: 300;">
                          Best regards,<br>
                          Blockmaze Team
                        </p>
                      </td>
                    </tr>

                  </table>
                </td>
              </tr>
            </table>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
