# Ethereum Node
# Default: Public Sepolia RPC (More stable than Pocket)
ETHEREUM_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Database
DB_USERNAME=root
DB_PASSWORD=password
DB_HOST=127.0.0.1
DB_PORT=3306

# Redis
REDIS_URL=redis://localhost:6379/0

# Indexer
START_BLOCK=4000000 # Start from a recent block to see transactions faster
